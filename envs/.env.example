# =============================================================================
# Environment Variables — Portfolio Backend
# =============================================================================
#
# Copy this file to .env and fill in the values for local development.
# Never commit .env to the repository.
#
# When running with Docker Compose, these variables are set directly in
# docker-compose.yml.  This file is for running the backend locally without
# Docker (e.g. `uv run uvicorn app.main:app --reload`).
# =============================================================================

# ── Application ───────────────────────────────────────────────────────────────

ENVIRONMENT=development
DEBUG=true

# ── Database ──────────────────────────────────────────────────────────────────
# asyncpg driver format.  For local development without Docker, create a
# local PostgreSQL database first:
#   createdb portfolio

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/portfolio

# ── Redis ─────────────────────────────────────────────────────────────────────
# Rate limiting.  If Redis is not running locally, the app starts without it
# and rate limiting is automatically disabled.

REDIS_URL=redis://localhost:6379/0

# ── CORS ──────────────────────────────────────────────────────────────────────
# JSON-encoded list of allowed origins.  Add your production domain here.

ALLOWED_ORIGINS=["http://localhost:5173"]

# ── Rate Limiting ─────────────────────────────────────────────────────────────

RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=3600

# ── Admin Authentication ───────────────────────────────────────────────────────
# Credentials for the single admin user.  There is no admin_users DB table —
# credentials live entirely in environment variables.
#
# Generate the password hash:
#   python -m app.cli.hash_password
#
# Generate the JWT secret (must be >= 32 chars):
#   python -c "import secrets; print(secrets.token_hex(64))"

# Admin email address (used as the JWT sub claim)
ADMIN_EMAIL=admin@example.com

# bcrypt hash of the admin password (starts with $2b$12$)
ADMIN_PASSWORD_HASH=

# HS256 JWT signing secret — generate a strong random value for production
ADMIN_JWT_SECRET=dev-secret-CHANGE-IN-PRODUCTION-must-be-32-plus-chars!!

# JWT issuer and audience — must match across API and frontend config
ADMIN_JWT_ISSUER=api.brensaud.com
ADMIN_JWT_AUDIENCE=admin.brensaud.com

# Access token TTL (minutes) and refresh token TTL (seconds)
ADMIN_JWT_ACCESS_TTL_MINUTES=15
ADMIN_REFRESH_TTL_SECONDS=86400

# Admin login rate limiting
ADMIN_LOGIN_RATE_LIMIT_ATTEMPTS=5
ADMIN_LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
ADMIN_LOGIN_LOCKOUT_THRESHOLD=10
ADMIN_LOGIN_LOCKOUT_SECONDS=1800
